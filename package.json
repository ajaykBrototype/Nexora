{
  "name": "nexora",
  "version": "1.0.0",
  "private": true,
  "description": "AI-powered recruitment and talent management platform",
  "packageManager": "pnpm@12.23.0",
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "build": "pnpm -r build",
